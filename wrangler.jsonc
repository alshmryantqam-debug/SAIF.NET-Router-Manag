
{
  "name": "saif-net",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  
"assets": {
  "directory": ".",
  "binding": "ASSETS",
  "not_found_handling": "single-page-application",
  "run_worker_first": ["/api/*"]
}

  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saif-net-db",
      "database_id": "47baed2a-8feb-4421-b73f-cd4a574b0729"
    }
  ]
}
